# Salin file ini menjadi .env.local, lalu isi dengan Project URL
# dan anon public key dari Supabase (Settings > API di dashboard Supabase Anda)

NEXT_PUBLIC_SUPABASE_URL=https://walelatteylcsxhrpcis.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi_dengan_anon_public_key_anda

# --- Backup ke GitHub ---
# Fine-grained personal access token GitHub, dibuat khusus untuk SATU repo
# backup (bukan repo kode aplikasi ini), izin "Contents: Read and write" saja.
# Buat di: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_isi_dengan_token_anda

# Repo tujuan backup, format username/nama-repo. Sarankan repo PRIVAT
# terpisah, khusus untuk menyimpan backup data.
GITHUB_BACKUP_REPO=tirsasaki/bukuhutang-backup

# Opsional. {user_id} otomatis diganti UUID akun yang login, sehingga tiap
# akun punya file backup terpisah di repo yang sama.
GITHUB_BACKUP_PATH=backups/{user_id}.json

# Opsional. Kosongkan untuk pakai branch default repo.
GITHUB_BACKUP_BRANCH=
